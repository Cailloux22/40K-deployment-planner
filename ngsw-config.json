{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/icon/**",
          "/assets/icons/**"
        ]
      }
    },
    {
      "name": "referentials",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/referentials/*.json"]
      }
    },
    {
      "name": "boards",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/referentials/boards/**"]
      }
    },
    {
      "name": "missions",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/referentials/missions/**"]
      }
    }
  ]
}
